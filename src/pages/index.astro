---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import Process from '../components/sections/Process.astro';
import Trust from '../components/sections/Trust.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import CTASection from '../components/sections/CTASection.astro';
import Footer from '../components/sections/Footer.astro';
import Marquee from '../components/ui/Marquee.astro';

const allFaqs = await getCollection('faqs');
const sortedFaqs = allFaqs.sort((a, b) => (a.data.orden ?? 0) - (b.data.orden ?? 0));
const faqData = sortedFaqs.map((f) => ({
  pregunta: f.data.pregunta,
  respuesta: f.data.respuesta,
}));
---

<Base
  title="HARNESS STUDIO | Desarrollo Web, Tiendas y Software a Medida"
  description="Desarrollo de sitios web ultrarrápidos, personalización de Tienda Nube, tiendas online y software a medida para pymes y emprendedores."
  faqs={faqData}
>
  <Nav slot="header" />

  <Hero />

  <Marquee text="LIGHTHOUSE 95+ ✦ DESARROLLO A MEDIDA ✦ CERO COMISIONES ✦ ASTRO Y TAILWIND ✦ CÓDIGO 100% TUYO" />

  <ServicesSection />

  <Process />

  <Trust />

  <FAQSection />

  <CTASection />

  <Footer slot="footer" />
</Base>
