---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import ServicesProcess from '../components/sections/ServicesProcess.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import CTASection from '../components/sections/CTASection.astro';

const allFaqs = await getCollection('faqs');
const esFaqs = allFaqs.filter((f) => (f.data.lang || 'es') === 'es');
const sortedFaqs = esFaqs.sort((a, b) => (a.data.orden ?? 0) - (b.data.orden ?? 0));
const faqData = sortedFaqs.map((f) => ({
  pregunta: f.data.pregunta,
  respuesta: f.data.respuesta,
}));
---

<Base
  title="HARNESS STUDIO | Desarrollo Web, Tiendas y Software a Medida"
  description="Desarrollo de sitios web ultrarrápidos, personalización de Tienda Nube, tiendas online y software a medida para pymes y emprendedores."
  faqs={faqData}
>
  <Nav slot="header" />

  <Hero />

  <ServicesProcess />

  <FAQSection />

  <CTASection />

</Base>
