---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/sections/Nav.astro';
import CTASection from '../../components/sections/CTASection.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import Accordion from '../../components/ui/Accordion.astro';
import ServiceHeroVisual from '../../components/ui/ServiceHeroVisual.astro';
import { getServiceNumber, getServiceSlug } from '../../utils/services';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({
    params: { slug: getServiceSlug(entry) },
    props: { entry, number: getServiceNumber(services, getServiceSlug(entry)) },
  }));
}

const { entry, number } = Astro.props;
const { data } = entry;
const slug = getServiceSlug(entry);

// H1 con el lenguaje tipográfico de la marca: las dos últimas palabras en serif itálica naranja.
const h1Words = data.h1.trim().split(/\s+/);
const h1Accent = h1Words.slice(-2).join(' ');
const h1Lead = h1Words.slice(0, -2).join(' ');

const heroHighlights = data.incluye.slice(0, 3).map((item) => item.titulo);

const waHeroUrl = `https://wa.me/?text=${encodeURIComponent(data.whatsappMensaje)}`;
const planWaUrl = (planName: string) =>
  `https://wa.me/?text=${encodeURIComponent(`Hola, me interesa el plan "${planName}" para el servicio de ${data.nombre}. ¿Podemos coordinar?`)}`;

const breadcrumbs = [
  { name: 'Inicio', item: '/' },
  { name: 'Servicios', item: '/#servicios' },
  { name: data.nombre, item: `/servicios/${slug}` },
];

const serviceSchemaData = {
  name: data.nombre,
  description: data.bajada,
  url: `/servicios/${slug}`,
  offers: data.planes.map((p) => ({ name: p.nombre, price: p.precio })),
};

const faqItems = (data.faqs || []).map((f) => ({
  pregunta: f.pregunta,
  respuesta: f.respuesta,
}));

const defaultSteps = [
  {
    titulo: 'Brief inicial',
    descripcion: 'Conversamos por WhatsApp o videollamada para entender tu negocio, propuesta de valor y requerimientos puntuales.',
  },
  {
    titulo: 'Propuesta clara',
    descripcion: 'Te enviamos un alcance cerrado con plazos exactos, precio fijo y los entregables detallados, sin sorpresas.',
  },
  {
    titulo: 'Diseño enfocado',
    descripcion: 'Creamos una interfaz audaz adaptada a tu público objetivo, optimizada para convertir visitas en consultas.',
  },
  {
    titulo: 'Desarrollo veloz',
    descripcion: 'Construimos el sitio con Astro y código limpio, alcanzando 95+ en Lighthouse y tiempos de carga instantáneos.',
  },
  {
    titulo: 'Lanzamiento & Soporte',
    descripcion: 'Conectamos tu dominio, publicamos en producción y te damos 30 días de garantía con soporte técnico directo.',
  },
];

const displayProceso = (data as any).proceso && (data as any).proceso.length > 0 ? (data as any).proceso : defaultSteps;
---

<Base
  title={data.metaTitle}
  description={data.metaDescription}
  canonical={`https://harness.studio/servicios/${slug}`}
  service={serviceSchemaData}
  breadcrumbs={breadcrumbs}
  faqs={faqItems}
>
  <Nav slot="header" />

  <!-- 1. Hero del servicio -->
  <section aria-labelledby="service-hero-title" class="service-hero relative isolate overflow-hidden">
    <!-- Atmósfera: grilla técnica enmascarada + resplandor naranja -->
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="service-hero__grid absolute inset-0"></div>
      <div class="absolute right-[-10%] top-1/2 h-[42rem] w-[42rem] -translate-y-1/2 rounded-full bg-[radial-gradient(circle,var(--accent)_0%,transparent_65%)] opacity-[0.14] blur-3xl lg:right-[5%]"></div>
    </div>

    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-16 px-4 pb-20 pt-32 sm:px-6 sm:pb-24 sm:pt-40 lg:grid-cols-12 lg:gap-10 lg:px-8">
      <!-- Columna izquierda -->
      <div class="flex flex-col gap-6 lg:col-span-7">
        <nav aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-wider text-text-secondary sm:text-sm">
            <li>
              <a href="/" class="underline-offset-4 transition-colors hover:text-accent hover:underline">
                Inicio
              </a>
            </li>
            <li aria-hidden="true" class="text-text-muted">/</li>
            <li>
              <a href="/#servicios" class="underline-offset-4 transition-colors hover:text-accent hover:underline">
                Servicios
              </a>
            </li>
            <li aria-hidden="true" class="text-text-muted">/</li>
            <li class="text-text-primary" aria-current="page">
              {data.nombre}
            </li>
          </ol>
        </nav>

        <h1
          id="service-hero-title"
          class="font-display text-4xl font-black uppercase leading-[0.95] tracking-tight text-text-primary sm:text-6xl xl:text-7xl"
        >
          {h1Lead}{h1Lead && ' '}<span class="font-serif font-normal italic tracking-normal text-accent">{h1Accent}</span>
        </h1>

        <p class="max-w-2xl text-lg font-medium leading-relaxed text-text-secondary sm:text-xl">
          {data.bajada}
        </p>

        <div class="flex flex-wrap items-center gap-4 pt-2">
          <Button
            href={waHeroUrl}
            target="_blank"
            rel="noopener noreferrer"
            variant="primary"
            size="lg"
          >
            Consultar por WhatsApp
          </Button>
          <Button href="#precios" variant="secondary" size="lg">
            Ver planes y precios ↓
          </Button>
        </div>

        <ul class="mt-4 grid grid-cols-1 gap-4 border-t border-border-subtle pt-6 sm:grid-cols-3">
          {
            heroHighlights.map((highlight) => (
              <li class="flex items-start gap-3 text-sm font-medium leading-snug text-text-secondary">
                <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-accent/40 bg-accent/10 text-accent" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none" class="h-3 w-3">
                    <path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                {highlight}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna derecha: composición visual (solo desktop) -->
      <div class="hidden lg:col-span-5 lg:block">
        <ServiceHeroVisual slug={slug} nombre={data.nombre} number={number} />
      </div>
    </div>
  </section>

  <!-- 2. Qué incluye -->
  <section
    aria-labelledby="incluye-heading"
    class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 border-t-3 border-black bg-gray-100"
  >
    <div class="max-w-7xl mx-auto">
      <div class="mb-12 sm:mb-16">
        <span class="text-xs sm:text-sm font-black uppercase tracking-widest text-accent mb-3 block">
          Entregables claros
        </span>
        <h2
          id="incluye-heading"
          class="font-display text-3xl sm:text-5xl lg:text-6xl font-black uppercase text-black leading-tight tracking-tight"
        >
          QUÉ INCLUYE <span class="font-serif italic font-normal text-accent tracking-normal">EL SERVICIO</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          data.incluye.map((item) => (
            <div class="border-brutal shadow-brutal p-6 sm:p-8 bg-white flex flex-col gap-3">
              <h3 class="font-display text-xl sm:text-2xl font-bold uppercase text-black flex items-center gap-3">
                <span class="inline-flex items-center justify-center w-7 h-7 bg-accent border-2 border-black text-black font-black text-sm shrink-0">
                  ✔
                </span>
                {item.titulo}
              </h3>
              <p class="text-gray-800 text-base sm:text-lg font-medium leading-relaxed">
                {item.descripcion}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. Precios y planes -->
  <section
    id="precios"
    aria-labelledby="precios-heading"
    class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 border-t-3 border-black bg-white"
  >
    <div class="max-w-7xl mx-auto">
      <div class="mb-12 sm:mb-16">
        <span class="text-xs sm:text-sm font-black uppercase tracking-widest text-accent mb-3 block">
          Inversión clara
        </span>
        <h2
          id="precios-heading"
          class="font-display text-3xl sm:text-5xl lg:text-6xl font-black uppercase text-black leading-tight tracking-tight"
        >
          PLANES <span class="font-serif italic font-normal text-accent tracking-normal">Y ESTIMACIONES</span>
        </h2>
        <p class="mt-4 text-lg sm:text-xl text-gray-500 font-medium max-w-2xl">
          Precios transparentes y plazos concretos. Sin sorpresas ni costos ocultos.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
        {
          data.planes.map((plan) => (
            <div
              data-plan-card
              class={`border-brutal p-8 flex flex-col justify-between transition-transform relative ${
                plan.destacado
                  ? 'bg-accent/5 border-3 border-accent shadow-[6px_6px_0_var(--accent)]'
                  : 'bg-white shadow-brutal'
              }`}
            >
              {plan.destacado && (
                <div class="absolute -top-3.5 right-6">
                  <Badge variant="orange">Recomendado</Badge>
                </div>
              )}

              <div>
                <span class="text-xs uppercase font-extrabold text-accent tracking-widest block mb-2">
                  Tiempo estimado: {plan.plazo}
                </span>

                <h3 class="font-display text-2xl sm:text-3xl font-black uppercase text-black mb-3">
                  {plan.nombre}
                </h3>

                <div class="text-3xl sm:text-4xl font-display font-black text-black mb-6">
                  {plan.precio}
                </div>

                <div class="border-t-2 border-gray-100 pt-6 mb-8">
                  <span class="text-xs font-bold uppercase text-gray-500 tracking-wider block mb-4">
                    Incluye:
                  </span>
                  <ul class="space-y-3 text-sm sm:text-base text-gray-800 font-medium">
                    {plan.incluye.map((feat) => (
                      <li class="flex items-start gap-2.5">
                        <span class="text-accent font-bold leading-none mt-1">▪</span>
                        <span>{feat}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <Button
                href={planWaUrl(plan.nombre)}
                target="_blank"
                rel="noopener noreferrer"
                variant={plan.destacado ? 'primary' : 'outline-dark'}
                size="md"
                class="w-full text-center justify-center font-bold"
              >
                Elegir este plan ➔
              </Button>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Cómo trabajamos (Proceso) -->
  <section
    id="proceso"
    aria-labelledby="proceso-servicio-heading"
    class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 border-t-3 border-black bg-gray-100"
  >
    <div class="max-w-7xl mx-auto">
      <div class="mb-12 sm:mb-16">
        <span class="text-xs sm:text-sm font-black uppercase tracking-widest text-accent mb-3 block">
          Paso a paso
        </span>
        <h2
          id="proceso-servicio-heading"
          class="font-display text-3xl sm:text-5xl lg:text-6xl font-black uppercase text-black leading-tight tracking-tight"
        >
          CÓMO <span class="font-serif italic font-normal text-accent tracking-normal">TRABAJAMOS</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {displayProceso.map((paso: { titulo: string; descripcion: string }, idx: number) => (
          <div class="border-brutal shadow-brutal p-6 sm:p-8 bg-white flex flex-col justify-between">
            <div>
              <span class="font-display text-4xl font-black text-accent block mb-3">
                0{idx + 1}
              </span>
              <h3 class="font-display text-xl sm:text-2xl font-black uppercase text-black mb-3">
                {paso.titulo}
              </h3>
              <p class="text-gray-800 text-sm sm:text-base font-medium leading-relaxed">
                {paso.descripcion}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. FAQs específicas del servicio -->
  {
    faqItems.length > 0 && (
      <section
        aria-labelledby="faqs-servicio-heading"
        class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 border-t-3 border-black bg-white"
      >
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12 sm:mb-16">
            <span class="text-xs sm:text-sm font-black uppercase tracking-widest text-accent mb-3 block">
              Dudas comunes
            </span>
            <h2
              id="faqs-servicio-heading"
              class="font-display text-3xl sm:text-5xl font-black uppercase text-black leading-tight tracking-tight"
            >
              PREGUNTAS <span class="font-serif italic font-normal text-accent tracking-normal">DEL SERVICIO</span>
            </h2>
          </div>

          <div class="space-y-4">
            {faqItems.map((f, i) => (
              <Accordion question={f.pregunta} answer={f.respuesta} open={i === 0} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 7. CTA final contextual -->
  <CTASection
    badge="Hablemos de tu proyecto"
    title={`¿Listo para avanzar con ${data.nombre}?`}
    subtitle="Escribinos por WhatsApp para coordinar los detalles y empezar esta misma semana."
    message={data.whatsappMensaje}
  />
</Base>

<style>
  .service-hero__grid {
    background-image: 
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 65% at 60% 45%, #000 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 70% 65% at 60% 45%, #000 20%, transparent 80%);
  }
</style>
