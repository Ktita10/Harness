---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/sections/Nav.astro';
import ServiceDetailPage from '../../components/sections/ServiceDetailPage.astro';
import { getServiceSlug } from '../../utils/services';

export async function getStaticPaths() {
  const allServices = await getCollection('services');
  const esServices = allServices.filter((s) => (s.data.lang || 'es') === 'es');
  return esServices.map((entry) => ({
    params: { slug: getServiceSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const slug = getServiceSlug(entry);

const breadcrumbs = [
  { name: 'Inicio', item: '/' },
  { name: 'Servicios', item: '/#servicios' },
  { name: data.nombre, item: `/servicios/${slug}` },
];

const serviceSchemaData = {
  name: data.nombre,
  description: data.bajada,
  url: `/servicios/${slug}`,
  offers: data.planes.map((p) => ({ name: p.nombre, price: p.precio })),
};

const faqItems = (data.faqs || []).map((f) => ({
  pregunta: f.pregunta,
  respuesta: f.respuesta,
}));
---

<Base
  title={data.metaTitle}
  description={data.metaDescription}
  canonical={`https://harness.studio/servicios/${slug}`}
  service={serviceSchemaData}
  breadcrumbs={breadcrumbs}
  faqs={faqItems}
>
  <Nav slot="header" />
  <ServiceDetailPage entry={entry} lang="es" />
</Base>
