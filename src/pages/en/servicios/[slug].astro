---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/sections/Nav.astro';
import ServiceDetailPage from '../../../components/sections/ServiceDetailPage.astro';
import { getServiceSlug } from '../../../utils/services';
import { useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
  const enServices = await getCollection('services_en');
  return enServices.map((entry) => ({
    params: { slug: getServiceSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const slug = getServiceSlug(entry);
const t = useTranslations('en');

const breadcrumbs = [
  { name: t('service.breadcrumb.home'), item: '/en' },
  { name: t('service.breadcrumb.services'), item: '/en#servicios' },
  { name: data.nombre, item: `/en/servicios/${slug}` },
];

const serviceSchemaData = {
  name: data.nombre,
  description: data.bajada,
  url: `/en/servicios/${slug}`,
  offers: data.planes.map((p) => ({ name: p.nombre, price: p.precio })),
};

const faqItems = (data.faqs || []).map((f) => ({
  pregunta: f.pregunta,
  respuesta: f.respuesta,
}));
---

<Base
  lang="en"
  title={data.metaTitle}
  description={data.metaDescription}
  canonical={`https://harness.studio/en/servicios/${slug}`}
  faqs={faqItems}
  service={serviceSchemaData}
  breadcrumbs={breadcrumbs}
>
  <Nav slot="header" lang="en" />
  <ServiceDetailPage entry={entry} lang="en" />
</Base>
