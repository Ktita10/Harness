---
interface FAQItem {
  pregunta: string;
  respuesta: string;
}

interface ServiceData {
  name: string;
  description: string;
  url: string;
  offers?: { name: string; price: string }[];
}

interface BreadcrumbItem {
  name: string;
  item: string;
}

interface Props {
  type?: 'Organization' | 'FAQPage' | 'Service' | 'BreadcrumbList' | 'All';
  faqs?: FAQItem[];
  service?: ServiceData;
  breadcrumbs?: BreadcrumbItem[];
}

const { type = 'All', faqs = [], service, breadcrumbs = [] } = Astro.props;

const siteUrl = Astro.site ? Astro.site.href : 'https://harness.studio';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'HARNESS STUDIO',
  url: siteUrl,
  logo: `${siteUrl}favicon.svg`,
  description: 'Startup de desarrollo web, landing pages y software a medida para pymes.',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    availableLanguage: ['Spanish', 'English'],
  },
};

const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.pregunta,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.respuesta,
    },
  })),
} : null;

const breadcrumbSchema = breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: crumb.name,
    item: crumb.item.startsWith('http') ? crumb.item : new URL(crumb.item, siteUrl).href,
  })),
} : null;

const serviceSchema = service ? {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.description,
  url: service.url.startsWith('http') ? service.url : new URL(service.url, siteUrl).href,
  provider: {
    '@type': 'Organization',
    name: 'HARNESS STUDIO',
    url: siteUrl,
  },
  serviceType: service.name,
  ...(service.offers && service.offers.length > 0 ? {
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: service.name,
      itemListElement: service.offers.map((offer) => ({
        '@type': 'Offer',
        name: offer.name,
        price: offer.price,
      })),
    },
  } : {}),
} : null;
---

{
  (type === 'Organization' || type === 'All') && (
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  )
}

{
  (type === 'FAQPage' || type === 'All') && faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )
}

{
  (type === 'BreadcrumbList' || type === 'All') && breadcrumbSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  )
}

{
  (type === 'Service' || type === 'All') && serviceSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  )
}
