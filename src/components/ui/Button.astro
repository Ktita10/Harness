---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'dark';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  target?: string;
  rel?: string;
  type?: 'button' | 'submit' | 'reset';
  [key: string]: any;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  target,
  rel,
  type = 'button',
  ...rest
} = Astro.props;

const variantClasses = {
  primary: 'bg-accent text-black hover:bg-accent-hover hover:shadow-[0_0_25px_var(--accent-glow)] active:scale-[0.98]',
  secondary: 'bg-white/5 text-white border border-white/15 hover:bg-white/10 hover:border-white/30 active:scale-[0.98]',
  dark: 'bg-zinc-900 text-white border border-white/10 hover:bg-zinc-800 hover:border-white/20 active:scale-[0.98]',
};

const sizeClasses = {
  sm: 'px-4 py-2 text-xs rounded-full font-semibold',
  md: 'px-6 py-2.5 text-sm rounded-full font-bold',
  lg: 'px-8 py-3.5 text-base rounded-full font-bold',
};

const baseClasses = `btn-brutal uppercase tracking-wider text-center select-none transition-all duration-200 ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;
---

{
  href ? (
    <a
      href={href}
      target={target}
      rel={rel ?? (target === '_blank' ? 'noopener noreferrer' : undefined)}
      class={baseClasses}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button type={type} class={baseClasses} {...rest}>
      <slot />
    </button>
  )
}
