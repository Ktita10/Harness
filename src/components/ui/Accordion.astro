---
interface Props {
  question: string;
  answer: string;
  name?: string;
  open?: boolean;
}

const { question, answer, name, open = false } = Astro.props;
---

<details
  class="group border-brutal shadow-brutal bg-white transition-all duration-150 open:bg-gray-100 mb-4"
  name={name}
  open={open}
>
  <summary class="flex justify-between items-center p-5 sm:p-6 cursor-pointer list-none select-none font-bold text-lg sm:text-xl text-black hover:text-orange transition-colors">
    <span class="pr-4">{question}</span>
    <span class="inline-flex items-center justify-center w-8 h-8 border-2 border-black bg-orange text-black font-extrabold text-xl shrink-0 group-open:rotate-45 transition-transform duration-200">
      +
    </span>
  </summary>
  <div class="px-5 pb-6 pt-2 text-gray-800 text-base sm:text-lg border-t-2 border-black/10 leading-relaxed">
    <p>{answer}</p>
  </div>
</details>
