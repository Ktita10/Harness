---
interface Props {
  variant?: 'orange' | 'black' | 'gray' | 'white' | 'glass';
  rotate?: -3 | -2 | -1 | 0 | 1 | 2 | 3;
  class?: string;
}

const {
  variant = 'orange',
  rotate = 0,
  class: className = '',
} = Astro.props;

const isGlass = variant === 'glass';

const variantClasses = {
  orange: 'bg-accent text-accent-contrast border-accent',
  black: 'bg-black text-white border-black',
  gray: 'bg-gray-100 text-black border-black',
  white: 'bg-white text-black border-black',
  glass: '',
};

const rotateClasses = {
  [-3]: '-rotate-3',
  [-2]: '-rotate-2',
  [-1]: '-rotate-1',
  [0]: 'rotate-0',
  [1]: 'rotate-1',
  [2]: 'rotate-2',
  [3]: 'rotate-3',
};

// La variante glass no usa `border-brutal` (CSS sin capa que pisaría el color del borde).
const baseClasses = isGlass
  ? 'inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs sm:text-sm font-bold uppercase tracking-widest text-accent backdrop-blur-sm'
  : `inline-block px-3 py-1 text-xs sm:text-sm font-extrabold uppercase tracking-widest border-2 border-brutal shadow-sm ${variantClasses[variant]}`;
---

<span class={`${baseClasses} ${rotateClasses[rotate]} ${className}`}>
  {isGlass && <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />}
  <slot />
</span>
