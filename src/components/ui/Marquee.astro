---
interface Props {
  text: string;
  repeat?: number;
  class?: string;
}

const { text, repeat = 6, class: className = '' } = Astro.props;
const items = Array.from({ length: repeat });
---

<div class={`relative z-20 overflow-hidden whitespace-nowrap border-y border-white/10 bg-[#0E0E10] py-3.5 select-none shadow-md ${className}`} aria-hidden="true">
  <div class="inline-flex animate-marquee gap-8 font-mono text-xs sm:text-sm font-bold uppercase tracking-widest text-zinc-400">
    {
      items.map(() => (
        <span class="inline-flex items-center gap-6">
          <span>{text}</span>
          <span class="text-accent font-black">✦</span>
        </span>
      ))
    }
  </div>
</div>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-marquee {
    display: inline-flex;
    width: max-content;
    animation: marquee 25s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-marquee {
      animation: none;
    }
  }
</style>
