---
import Button from '../ui/Button.astro';
import { getLangFromUrl, useTranslations, getAlternatePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const targetLang: Lang = currentLang === 'es' ? 'en' : 'es';
const alternatePath = getAlternatePath(Astro.url.pathname, targetLang);
const homePath = currentLang === 'en' ? '/en' : '/';

const navLinks = [
  { href: `${homePath}#servicios`, label: t('nav.services') },
  { href: `${homePath}#proceso`, label: t('nav.process') },
  { href: `${homePath}#faq`, label: t('nav.faq') },
];
---

<header
  id="site-header"
  role="banner"
  data-nav-tone="dark"
  class="fixed top-0 left-0 right-0 z-50 bg-transparent"
>
  <div class="nav-container w-full px-6 sm:px-10 lg:px-12 xl:px-16 h-20 sm:h-24 flex items-center justify-between">
    <!-- Brand Logo: HARNESS destacado en el navbar -->
    <a
      href={homePath}
      class="flex items-center select-none group leading-none tracking-tighter py-1"
      aria-label="HARNESS Home"
    >
      <span class="nav-brand-title font-display font-black text-3xl sm:text-4xl lg:text-5xl uppercase leading-none transition-colors duration-300">
        HARNESS
      </span>
    </a>

    <!-- Desktop Navigation Links & Language Switcher -->
    <div class="hidden md:flex items-center gap-6 lg:gap-10 ml-auto">
      <nav class="flex items-center gap-8 lg:gap-12 text-xs sm:text-sm lg:text-base font-bold uppercase tracking-widest" aria-label="Navegación principal">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="nav-link-item relative py-1 transition-colors duration-300 hover:after:w-full after:w-0 after:h-[2px] after:bg-accent after:absolute after:bottom-0 after:left-0 after:transition-all after:duration-250"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- Botón compacto de idioma con ícono de globo (Desktop) -->
      <a
        href={alternatePath}
        class="nav-lang-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-xs font-mono font-bold uppercase tracking-wider transition-all duration-300 hover:scale-105 select-none"
        aria-label={t('nav.switchLang')}
        title={t('nav.switchLang')}
      >
        <svg
          class="w-3.5 h-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span class="text-[11px] font-black">{targetLang.toUpperCase()}</span>
      </a>
    </div>

    <!-- Mobile Menu Toggle Button & Mobile Switcher -->
    <div class="md:hidden flex items-center gap-3">
      <!-- Botón compacto de idioma con ícono de globo (Mobile Navbar) -->
      <a
        href={alternatePath}
        class="nav-lang-btn inline-flex items-center gap-1 px-2.5 py-1.5 rounded-full border text-xs font-mono font-bold uppercase tracking-wider transition-all duration-300 select-none"
        aria-label={t('nav.switchLang')}
      >
        <svg
          class="w-3.5 h-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span class="text-[10px] font-black">{targetLang.toUpperCase()}</span>
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="p-2.5 rounded-lg border transition-all duration-300"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
        aria-label={t('nav.menuOpen')}
      >
        <svg
          id="menu-open-icon"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="w-6 h-6"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg
          id="menu-close-icon"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="w-6 h-6 hidden"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Overlay Drawer -->
  <div
    id="mobile-menu-drawer"
    class="md:hidden hidden border-b border-white/10 bg-[#0A0A0A]/95 backdrop-blur-xl px-6 py-8 flex-col gap-6 shadow-2xl"
    aria-hidden="true"
  >
    <nav class="flex flex-col gap-2 font-display text-base font-bold uppercase tracking-wider" aria-label="Navegación móvil">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link text-zinc-300 hover:text-accent py-3 border-b border-white/5 flex items-center justify-between transition-colors"
          >
            <span>{link.label}</span>
            <svg class="w-4 h-4 text-zinc-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </a>
        ))
      }
    </nav>
    <div class="pt-2">
      <Button
        href="https://wa.me/?text=Hola%20Harness%20Studio%2C%20quiero%20cotizar%20un%20proyecto"
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
        size="md"
        class="w-full text-center flex items-center justify-center gap-2"
      >
        <span>{t('nav.whatsapp')}</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
        </svg>
      </Button>
    </div>
  </div>
</header>

<style>
  /* Base state: transparent background with accordion transform */
  #site-header {
    background-color: transparent;
    transform: translateY(0) scaleY(1);
    transform-origin: top center;
    opacity: 1;
    transition:
      transform 440ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 320ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 300ms ease,
      backdrop-filter 300ms ease,
      border-color 300ms ease;
  }

  /* Scrolled state: transparente en toda la web sin línea divisoria */
  #site-header.is-scrolled {
    background-color: transparent !important;
    border-bottom: none !important;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  /* Sin fondo ni borde sobre fondo oscuro */
  #site-header.is-scrolled[data-nav-tone="dark"] {
    background-color: transparent !important;
    border-bottom: none !important;
  }

  /* Sin fondo ni borde sobre fondo claro */
  #site-header.is-scrolled[data-nav-tone="light"] {
    background-color: transparent !important;
    border-bottom: none !important;
  }

  /* Inner container accordion compression */
  #site-header .nav-container {
    transform: scaleY(1);
    transform-origin: top center;
    transition:
      transform 440ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Accordion hide towards top */
  #site-header[data-nav-hidden="true"] {
    transform: translateY(-100%) scaleY(0.2);
    opacity: 0;
    pointer-events: none !important;
    transition:
      transform 380ms cubic-bezier(0.7, 0, 0.84, 0),
      opacity 250ms ease;
  }

  #site-header[data-nav-hidden="true"] .nav-container {
    transform: scaleY(0.3);
    opacity: 0;
  }

  /* When mobile drawer is open: solid dark bar */
  #site-header.is-mobile-open {
    background-color: rgba(10, 10, 10, 0.98) !important;
    backdrop-filter: blur(16px);
    transform: translateY(0) scaleY(1) !important;
    opacity: 1 !important;
  }

  /* Dark mode: white elements */
  #site-header[data-nav-tone="dark"] .nav-brand-title {
    color: #FFFFFF;
  }
  #site-header[data-nav-tone="dark"] .nav-link-item {
    color: #FFFFFF;
  }
  #site-header[data-nav-tone="dark"] #mobile-menu-btn {
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.15);
    background-color: rgba(255, 255, 255, 0.05);
  }
  #site-header[data-nav-tone="dark"] .nav-lang-btn {
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.2);
    background-color: rgba(255, 255, 255, 0.05);
  }

  /* Light mode: black elements over light/white backgrounds */
  #site-header[data-nav-tone="light"]:not(.is-mobile-open) .nav-brand-title {
    color: #0D0D0D;
  }
  #site-header[data-nav-tone="light"]:not(.is-mobile-open) .nav-link-item {
    color: #0D0D0D;
  }
  #site-header[data-nav-tone="light"]:not(.is-mobile-open) #mobile-menu-btn {
    color: #0D0D0D;
    border-color: rgba(0, 0, 0, 0.18);
    background-color: rgba(0, 0, 0, 0.04);
  }
  #site-header[data-nav-tone="light"]:not(.is-mobile-open) .nav-lang-btn {
    color: #0D0D0D;
    border-color: rgba(0, 0, 0, 0.2);
    background-color: rgba(0, 0, 0, 0.04);
  }

  /* Mobile open overrides */
  #site-header.is-mobile-open .nav-brand-title {
    color: #FFFFFF !important;
  }
  #site-header.is-mobile-open #mobile-menu-btn {
    color: #FFFFFF !important;
    border-color: rgba(255, 255, 255, 0.25) !important;
    background-color: rgba(255, 255, 255, 0.1) !important;
  }
  #site-header.is-mobile-open .nav-lang-btn {
    color: #FFFFFF !important;
    border-color: rgba(255, 255, 255, 0.25) !important;
    background-color: rgba(255, 255, 255, 0.1) !important;
  }

  /* Hover transitions to brand accent */
  #site-header .nav-link-item:hover {
    color: var(--accent) !important;
  }
  #site-header #mobile-menu-btn:hover {
    color: var(--accent) !important;
    border-color: var(--accent) !important;
  }
  #site-header .nav-lang-btn:hover {
    color: var(--accent) !important;
    border-color: var(--accent) !important;
    background-color: rgba(255, 90, 0, 0.1) !important;
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header,
    #site-header .nav-container {
      transition: opacity 200ms ease !important;
      transform: none !important;
    }
    #site-header[data-nav-hidden="true"] {
      opacity: 0 !important;
      pointer-events: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  function setupNav() {
    const header = document.getElementById('site-header');
    const menuBtn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-menu-drawer');
    const openIcon = document.getElementById('menu-open-icon');
    const closeIcon = document.getElementById('menu-close-icon');
    const navLinks = document.querySelectorAll('.mobile-nav-link');

    if (!header || !menuBtn || !drawer) return;

    function toggleMenu() {
      const isExpanded = menuBtn?.getAttribute('aria-expanded') === 'true';
      const nextExpanded = !isExpanded;
      menuBtn?.setAttribute('aria-expanded', String(nextExpanded));
      menuBtn?.setAttribute('aria-label', nextExpanded ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
      header?.classList.toggle('is-mobile-open', nextExpanded);
      drawer?.classList.toggle('hidden', !nextExpanded);
      drawer?.classList.toggle('flex', nextExpanded);
      drawer?.setAttribute('aria-hidden', String(!nextExpanded));
      openIcon?.classList.toggle('hidden', nextExpanded);
      closeIcon?.classList.toggle('hidden', !nextExpanded);

      if (!nextExpanded) {
        evaluateState();
      }
    }

    menuBtn.addEventListener('click', toggleMenu);

    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (!drawer.classList.contains('hidden')) {
          toggleMenu();
        }
      });
    });

    const lightSelectors = [
      'section#faq',
      'section#contacto',
      '[data-faq-panel]',
      '[data-nav-light]',
      'section.bg-bg-secondary',
      'section.bg-white',
      'section.bg-gray-100',
      '.bg-bg-secondary',
    ].join(', ');

    let ticking = false;
    let isCtaActive = false;

    function evaluateState() {
      if (header?.classList.contains('is-mobile-open')) {
        header?.removeAttribute('data-nav-hidden');
        return;
      }

      const headerHeight = header?.offsetHeight || 80;
      const probeY = headerHeight * 0.5;
      const cta = document.getElementById('contacto');

      // 1. Accordion hide when arriving at the CTA section
      if (cta) {
        const ctaRect = cta.getBoundingClientRect();
        const enterThreshold = headerHeight;
        const leaveThreshold = headerHeight + 25;

        if (!isCtaActive && ctaRect.top <= enterThreshold && ctaRect.bottom > 0) {
          isCtaActive = true;
        } else if (isCtaActive && (ctaRect.top > leaveThreshold || ctaRect.bottom <= 0)) {
          isCtaActive = false;
        }
      } else {
        isCtaActive = false;
      }

      if (isCtaActive) {
        if (!header?.hasAttribute('data-nav-hidden')) {
          header?.setAttribute('data-nav-hidden', 'true');
        }
      } else {
        if (header?.hasAttribute('data-nav-hidden')) {
          header?.removeAttribute('data-nav-hidden');
        }
      }

      // 2. Dynamic tone inversion over light sections
      const candidates = document.querySelectorAll<HTMLElement>(lightSelectors);
      let isOverLight = false;

      for (const el of candidates) {
        const rect = el.getBoundingClientRect();
        if (rect.height < 30 || rect.width < 250) continue;

        if (rect.top <= probeY && rect.bottom >= probeY) {
          isOverLight = true;
          break;
        }
      }

      const targetTone = isOverLight ? 'light' : 'dark';
      if (header?.getAttribute('data-nav-tone') !== targetTone) {
        header?.setAttribute('data-nav-tone', targetTone);
      }

      // 3. Estado Scrolled: aplica difusión y desenfoque sutil
      const isScrolled = window.scrollY > 20;
      header?.classList.toggle('is-scrolled', isScrolled);
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(() => {
          evaluateState();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    // Initial evaluation and after dynamic DOM updates
    evaluateState();
    setTimeout(evaluateState, 100);
    setTimeout(evaluateState, 400);
    setTimeout(evaluateState, 1000);
  }

  // Support standard load and Astro page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNav);
  } else {
    setupNav();
  }
  document.addEventListener('astro:page-load', setupNav);
</script>
