---
import Badge from '../ui/Badge.astro';

const commitments = [
  {
    icon: '⚡',
    title: 'Velocidad garantizada',
    subtitle: 'Lighthouse 95+ en móviles',
    description: 'Optimizamos cada línea de código e imagen. Si tu sitio no alcanza el estándar de velocidad acordado en móvil, no pagás el saldo final.',
  },
  {
    icon: '🛡️',
    title: 'Propiedad total',
    subtitle: 'Código 100% tuyo',
    description: 'Sin letra chica ni ataduras de suscripción. El repositorio, los archivos y las cuentas de despliegue te pertenecen desde el primer día.',
  },
  {
    icon: '💬',
    title: 'Atención directa',
    subtitle: 'Sin intermediarios',
    description: 'Hablás directamente por WhatsApp con quien programa tu sitio. Respuestas rápidas, decisiones inmediatas y feedback continuo.',
  },
  {
    icon: '🎯',
    title: 'Precio cerrado',
    subtitle: 'Cero sorpresas',
    description: 'Cotizamos con alcance fijo y plazos claros. No hay costos ocultos ni adiciones imprevistas al momento del lanzamiento.',
  },
];
---

<section
  id="confianza"
  aria-labelledby="trust-title"
  class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-3 border-black bg-white"
>
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-16">
    <div>
      <Badge variant="orange" class="mb-3">Credibilidad</Badge>
      <h2
        id="trust-title"
        class="font-display text-3xl sm:text-5xl lg:text-6xl font-black uppercase text-black leading-tight tracking-tight"
      >
        Compromisos reales
      </h2>
    </div>
    <p class="text-base sm:text-lg text-gray-800 font-medium max-w-md">
      Sin testimonios inventados ni logos genéricos. Te mostramos exactamente las garantías técnicas y comerciales con las que trabajamos.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {
      commitments.map((item) => (
        <div class="border-brutal shadow-brutal p-6 sm:p-8 bg-white flex flex-col justify-between hover:bg-gray-100 transition-colors">
          <div>
            <span class="text-4xl block mb-4">{item.icon}</span>
            <h3 class="font-display text-xl sm:text-2xl font-black uppercase text-black mb-1">
              {item.title}
            </h3>
            <span class="text-xs uppercase font-extrabold text-orange tracking-widest block mb-4">
              {item.subtitle}
            </span>
            <p class="text-sm sm:text-base text-gray-800 font-medium leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>
