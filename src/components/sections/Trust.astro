---
const commitments = [
  {
    number: '01',
    title: 'Velocidad garantizada',
    subtitlePrefix: 'Lighthouse ',
    metric: '95+',
    counterValue: '95',
    counterSuffix: '+',
    subtitleSuffix: ' en móviles',
    description: 'Optimizamos cada línea de código e imagen. Si tu sitio no alcanza el estándar de velocidad acordado en móvil, no pagás el saldo final.',
    align: 'left',
  },
  {
    number: '02',
    title: 'Propiedad total',
    subtitlePrefix: 'Código ',
    metric: '100%',
    counterValue: '100',
    counterSuffix: '%',
    subtitleSuffix: ' tuyo',
    description: 'Sin letra chica ni ataduras de suscripción. El repositorio, los archivos y las cuentas de despliegue te pertenecen desde el primer día.',
    align: 'right',
  },
  {
    number: '03',
    title: 'Atención directa',
    subtitlePrefix: 'Sin intermediarios // ',
    metric: 'Contacto 1:1',
    subtitleSuffix: '',
    description: 'Hablás directamente por WhatsApp con quien programa tu sitio. Respuestas rápidas, decisiones inmediatas y feedback continuo.',
    align: 'left',
  },
  {
    number: '04',
    title: 'Precio cerrado',
    subtitlePrefix: '',
    metric: '0 costos ocultos',
    subtitleSuffix: ' // Alcance fijo',
    description: 'Cotizamos con alcance fijo y plazos claros. No hay costos ocultos ni adiciones imprevistas al momento del lanzamiento.',
    align: 'right',
  },
];
---

<section
  id="confianza"
  aria-labelledby="trust-title"
  class="w-full max-w-full overflow-hidden bg-white text-black py-24 sm:py-32 px-6 sm:px-12 lg:px-20 border-t border-black/10 relative"
>
  <!-- 1. Header Centrado (Width Liberado) -->
  <div data-trust-header class="text-center max-w-3xl mx-auto mb-20 sm:mb-28">
    <div class="inline-flex items-center gap-2 mb-4 font-mono text-xs uppercase tracking-widest text-accent font-bold">
      <span class="inline-block w-2 h-2 rounded-full bg-accent animate-pulse"></span>
      <span>04 / COMPROMISOS</span>
    </div>
    <h2
      id="trust-title"
      class="font-display text-4xl sm:text-6xl lg:text-7xl font-black uppercase text-black leading-none tracking-tight mb-6"
    >
      Compromisos reales
    </h2>
    <p class="text-base sm:text-xl text-zinc-600 font-normal leading-relaxed">
      Sin testimonios inventados ni logos genéricos. Te mostramos exactamente las garantías técnicas y comerciales con las que trabajamos.
    </p>
  </div>

  <!-- 2. Filas Intercaladas (Izquierda y Derecha) -->
  <div class="grid grid-cols-1 divide-y divide-black/10 border-y border-black/10">
    {
      commitments.map((item) => {
        const isRight = item.align === 'right';
        return (
          <div
            data-trust-row
            data-align={item.align}
            class="py-14 sm:py-20 flex flex-col transition-all"
          >
            <div
              class={`w-full lg:w-[58%] flex flex-col sm:flex-row items-start gap-6 sm:gap-10 ${
                isRight ? 'lg:ml-auto lg:pl-8' : 'lg:mr-auto lg:pr-8'
              }`}
            >
              <!-- Número de orden en outline -->
              <span
                class="font-display text-6xl sm:text-7xl lg:text-8xl font-black tracking-tighter select-none leading-none text-black flex-shrink-0"
                style="-webkit-text-stroke: 1.5px currentColor; color: transparent;"
              >
                {item.number}
              </span>

              <!-- Contenido principal -->
              <div class="flex-1">
                <span class="inline-block font-mono text-xs uppercase tracking-widest text-accent font-bold mb-3">
                  {item.subtitlePrefix}
                  {item.counterValue ? (
                    <span
                      data-counter={item.counterValue}
                      data-counter-suffix={item.counterSuffix}
                    >
                      {item.metric}
                    </span>
                  ) : (
                    item.metric
                  )}
                  {item.subtitleSuffix}
                </span>

                <h3 class="font-display text-2xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tight text-black leading-tight mb-4">
                  {item.title}
                </h3>

                <p class="text-base sm:text-lg text-zinc-600 leading-relaxed max-w-xl font-normal">
                  {item.description}
                </p>
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</section>
