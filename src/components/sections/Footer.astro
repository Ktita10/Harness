---
const currentYear = new Date().getFullYear();

const serviceLinks = [
  { href: '/servicios/landing-pages', label: 'Landing pages' },
  { href: '/servicios/tiendanube', label: 'Personalización de Tienda Nube' },
  { href: '/servicios/tienda-online', label: 'Tienda online propia' },
  { href: '/servicios/software-a-medida', label: 'Software a medida' },
];

const navLinks = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#proceso', label: 'Cómo trabajamos' },
  { href: '#confianza', label: 'Confianza' },
  { href: '#faq', label: 'FAQ' },
];
---

<footer role="contentinfo" class="bg-black text-white border-t-3 border-black py-16 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b-2 border-gray-800">
    <!-- Brand column -->
    <div class="md:col-span-2 flex flex-col gap-4">
      <a href="/" class="font-display font-black text-2xl uppercase tracking-tighter text-white flex items-center gap-2">
        <span class="w-4 h-4 bg-orange border-2 border-white inline-block"></span>
        <span>HARNESS STUDIO</span>
      </a>
      <p class="text-gray-300 text-sm sm:text-base max-w-sm leading-relaxed font-medium">
        Startup de desarrollo web y software. Sitios de alto rendimiento, optimizados para SEO y diseñados para convertir visitas en clientes.
      </p>
      <div class="pt-2">
        <span class="inline-block px-3 py-1 bg-gray-800 text-orange font-bold text-xs uppercase tracking-widest border border-gray-500">
          Buenos Aires, Argentina · Remoto
        </span>
      </div>
    </div>

    <!-- Services Links -->
    <div>
      <h3 class="font-display text-lg font-bold uppercase text-orange tracking-wider mb-4">
        Servicios
      </h3>
      <ul class="space-y-2.5 text-sm sm:text-base font-medium">
        {
          serviceLinks.map((service) => (
            <li>
              <a
                href={service.href}
                class="text-gray-300 hover:text-white transition-colors"
              >
                {service.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Navigation & Contact -->
    <div>
      <h3 class="font-display text-lg font-bold uppercase text-orange tracking-wider mb-4">
        Navegación
      </h3>
      <ul class="space-y-2.5 text-sm sm:text-base font-medium mb-6">
        {
          navLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-gray-300 hover:text-white transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <h3 class="font-display text-lg font-bold uppercase text-orange tracking-wider mb-2">
        Contacto
      </h3>
      <a
        href="https://wa.me/?text=Hola%20Harness%20Studio"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm sm:text-base text-gray-300 hover:text-orange font-bold flex items-center gap-2 transition-colors"
      >
        <span>WhatsApp directo ➔</span>
      </a>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="max-w-7xl mx-auto pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500 uppercase font-bold tracking-wider gap-4">
    <p>© {currentYear} HARNESS STUDIO. Todos los derechos reservados.</p>
    <p>Construido con Astro · Estilo Neo-Brutalista</p>
  </div>
</footer>
