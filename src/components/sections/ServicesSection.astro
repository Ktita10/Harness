---
import { getCollection } from 'astro:content';

const services = await getCollection('services');

// Defined sorting order matching SPEC.md
const order = ['landing-pages', 'tiendanube', 'tienda-online', 'software-a-medida'];
const sortedServices = services.sort((a, b) => {
  const slugA = (a.data.slug || a.id).replace(/\.md$/, '');
  const slugB = (b.data.slug || b.id).replace(/\.md$/, '');
  const indexA = order.indexOf(slugA);
  const indexB = order.indexOf(slugB);
  return (indexA === -1 ? 99 : indexA) - (indexB === -1 ? 99 : indexB);
});

// Staggered Y configurations for irregular initial resting positions
const yConfigs = [
  { offsetClass: 'lg:-translate-y-8', parallaxDir: 'down', tag: 'CONVERSIÓN DIRECTA' },
  { offsetClass: 'lg:translate-y-12', parallaxDir: 'up', tag: 'ECOMMERCE NUBE' },
  { offsetClass: 'lg:-translate-y-4', parallaxDir: 'down', tag: 'TIENDA INDEPENDIENTE' },
  { offsetClass: 'lg:translate-y-16', parallaxDir: 'up', tag: 'ARQUITECTURA A MEDIDA' },
];
---

<section
  id="servicios"
  aria-labelledby="services-title"
  class="relative py-24 sm:py-32 lg:py-40 px-4 sm:px-6 md:px-8 lg:px-10 xl:px-14 w-full max-w-full overflow-hidden select-none bg-bg-primary"
>
  <!-- Left-Aligned Header Block (Ancho liberado, pegado a la izquierda) -->
  <div data-services-header class="max-w-2xl mb-16 sm:mb-24 flex flex-col gap-4 text-left mr-auto">
    <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-accent font-semibold">
      <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
      <span>02 / SOLUCIONES</span>
    </div>
    <h2
      id="services-title"
      class="font-display text-3xl sm:text-5xl lg:text-6xl font-black uppercase text-white tracking-tight leading-[1.05]"
    >
      Servicios que ofrecemos
    </h2>
    <p class="text-base sm:text-lg text-zinc-400 font-normal leading-relaxed max-w-xl">
      Elegí la solución exacta para la etapa de tu negocio. Cuatro formatos técnicos concebidos para traccionar y escalar sin deuda de código.
    </p>
  </div>

  <!-- Irregular Staggered Square Cards Row -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6 xl:gap-8 items-start pt-6 pb-24 w-full">
    {
      sortedServices.map((service, index) => {
        const slug = (service.data.slug || service.id).replace(/\.md$/, '');
        const config = yConfigs[index % yConfigs.length];

        return (
          <article
            data-parallax-dir={config.parallaxDir}
            class={`group relative bg-bg-primary w-full aspect-square p-6 sm:p-7 xl:p-8 flex flex-col justify-between transition-transform duration-300 ${config.offsetClass}`}
          >
            <!-- SVG Border Silhouette: Notch en esquina inferior izquierda (~1/4 ancho, altura baja y redondeada) -->
            <svg
              class="absolute inset-0 w-full h-full pointer-events-none -z-0"
              viewBox="0 0 100 100"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path
                d="M 6 0 
                   L 94 0 Q 100 0 100 6 
                   L 100 94 Q 100 100 94 100 
                   L 28 100 Q 25 100 25 96 
                   L 25 95 Q 25 92 22 92 
                   L 6 92 Q 0 92 0 86 
                   L 0 6 Q 0 0 6 0 Z"
                fill="var(--bg-primary)"
                stroke="rgba(255, 255, 255, 0.12)"
                stroke-width="1.2"
                vector-effect="non-scaling-stroke"
                class="transition-all duration-300 group-hover:stroke-accent group-hover:filter group-hover:drop-shadow-[0_0_12px_rgba(255,90,0,0.25)]"
              />
            </svg>

            <!-- Card Content (Top) -->
            <div class="relative z-10 flex flex-col gap-3">
              <div class="flex items-baseline justify-between border-b border-white/5 pb-2.5">
                <span class="font-display text-3xl sm:text-4xl lg:text-5xl font-black text-accent tracking-tighter">
                  0{index + 1}
                </span>
                <span class="text-[9px] sm:text-[10px] font-mono uppercase tracking-widest text-zinc-500 font-semibold">
                  {config.tag}
                </span>
              </div>

              <!-- Title & Description -->
              <h3 class="font-display text-lg sm:text-xl lg:text-2xl font-bold uppercase tracking-tight text-white group-hover:text-accent transition-colors pt-1 leading-snug">
                {service.data.nombre}
              </h3>

              <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed font-normal line-clamp-3">
                {service.data.bajada}
              </p>
            </div>

            <!-- Card Content (Bottom): Clean text link -->
            <div class="relative z-10 pt-2 pb-1">
              <a
                href={`/servicios/${slug}`}
                class="inline-block text-xs uppercase tracking-widest font-bold text-zinc-300 group-hover:text-accent transition-colors"
              >
                Ver servicio
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>
