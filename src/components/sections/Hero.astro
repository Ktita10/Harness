---
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
---

<section
  id="hero"
  aria-labelledby="hero-title"
  class="pt-32 pb-20 sm:pt-40 sm:pb-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto flex flex-col justify-center min-h-[85vh]"
>
  <div class="flex flex-col gap-6 max-w-5xl">
    <!-- Top Sticker Badge -->
    <div class="self-start">
      <Badge variant="orange" rotate={-1}>
        Desarrollo Web & Software a Medida
      </Badge>
    </div>

    <!-- Main H1 (Single H1 on page) -->
    <h1
      id="hero-title"
      class="font-display text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black uppercase text-black leading-[0.95] tracking-tight"
    >
      Hacemos webs que <span class="bg-orange px-2 border-2 border-black inline-block mt-1 sm:mt-0 shadow-brutal rotate-1">convierten</span> y software que escala.
    </h1>

    <!-- Subtitle -->
    <p class="text-xl sm:text-2xl md:text-3xl text-gray-800 font-medium max-w-3xl leading-snug pt-2">
      Sitios veloces, sin plantillas genéricas ni código inflado. Para pymes y emprendedores que se toman en serio su presencia digital.
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap items-center gap-4 sm:gap-6 pt-6">
      <Button
        href="https://wa.me/?text=Hola%20Harness%20Studio%2C%20quiero%20cotizar%20un%20proyecto"
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
        size="lg"
      >
        Cotizar por WhatsApp
      </Button>

      <Button
        href="#servicios"
        variant="secondary"
        size="lg"
      >
        Ver Servicios ↓
      </Button>
    </div>

    <!-- Quick proof badges -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-10 border-t-3 border-black mt-6 text-sm font-bold uppercase tracking-wider">
      <div class="flex items-center gap-2">
        <span class="text-orange text-lg">■</span> Lighthouse 95+ Garantizado
      </div>
      <div class="flex items-center gap-2">
        <span class="text-orange text-lg">■</span> Sin comisiones por venta
      </div>
      <div class="flex items-center gap-2">
        <span class="text-orange text-lg">■</span> Código 100% tuyo
      </div>
      <div class="flex items-center gap-2">
        <span class="text-orange text-lg">■</span> Trato directo por WhatsApp
      </div>
    </div>
  </div>
</section>
