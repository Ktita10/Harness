---
---

<section
  id="hero"
  aria-labelledby="hero-title"
  class="relative pt-28 sm:pt-36 lg:pt-40 min-h-screen flex flex-col justify-between overflow-hidden bg-bg-primary select-none"
>
  <!-- Ambient Atmospheric Glow & Tech Grid -->
  <div
    class="absolute inset-0 pointer-events-none -z-10 bg-[radial-gradient(ellipse_75%_55%_at_50%_40%,rgba(255,90,0,0.12),transparent_70%)]"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-0 pointer-events-none -z-10 opacity-[0.03] bg-[linear-gradient(to_right,#ffffff_1px,transparent_1px),linear-gradient(to_bottom,#ffffff_1px,transparent_1px)] bg-[size:4rem_4rem]"
    aria-hidden="true"
  ></div>

  <!-- Top Asymmetrical Narrative Grid -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full z-10 flex-1 flex flex-col justify-center py-6 sm:py-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-start relative">
      <!-- Bloque Izquierdo (Elevado) -->
      <div class="md:col-span-5 lg:col-span-4 flex flex-col gap-3 md:pt-4">
        <div class="inline-flex items-center gap-2 text-[11px] font-mono tracking-widest uppercase text-accent font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
          <span>01 / VELOCIDAD & PRECISIÓN</span>
        </div>
        <h2 class="font-display font-black text-xl sm:text-2xl lg:text-3xl uppercase tracking-tight text-text-primary leading-[1.1]">
          Donde la velocidad bruta se encuentra con el diseño de culto.
        </h2>
        <p class="text-sm sm:text-base text-text-secondary leading-relaxed font-normal">
          Diseñamos y programamos plataformas pensadas para dominar la pantalla y transformar tráfico en tracción real.
        </p>
      </div>

      <!-- Centro (Espacio reservado para el futuro elemento 3D del nodo de cables) -->
      <div
        id="hero-3d-slot"
        class="hidden md:flex md:col-span-2 lg:col-span-4 min-h-[140px] lg:min-h-[200px] items-center justify-center relative pointer-events-none"
        aria-hidden="true"
      >
        <div class="w-28 h-28 rounded-full border border-white/5 flex items-center justify-center">
          <div class="w-14 h-14 rounded-full border border-accent/20 animate-pulse"></div>
        </div>
      </div>

      <!-- Bloque Derecho (Más bajo, ritmo asimétrico) -->
      <div class="md:col-span-5 lg:col-span-4 flex flex-col gap-3 md:mt-16 lg:mt-24">
        <div class="inline-flex items-center gap-2 text-[11px] font-mono tracking-widest uppercase text-accent font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-accent/60"></span>
          <span>02 / INFRAESTRUCTURA</span>
        </div>
        <h2 class="font-display font-black text-xl sm:text-2xl lg:text-3xl uppercase tracking-tight text-text-primary leading-[1.1]">
          Sin deuda técnica. Sin atajos.
        </h2>
        <p class="text-sm sm:text-base text-text-secondary leading-relaxed font-normal">
          Rendimiento quirúrgico, cero código inflado y tecnología construida a la medida de tu ambición.
        </p>
      </div>
    </div>
  </div>

  <!-- Bottom Centered H1 — HARNESS (Completamente visible, sin recorte forzado ni espacios residuales) -->
  <div class="w-full flex justify-center items-end mt-auto pointer-events-none pb-0">
    <h1
      id="hero-title"
      class="font-display font-black text-[18vw] sm:text-[19vw] lg:text-[20.5vw] leading-[0.82] tracking-tighter uppercase text-center select-none text-transparent bg-clip-text bg-gradient-to-b from-white via-white/90 to-white/40 drop-shadow-[0_20px_60px_rgba(255,90,0,0.15)] m-0 p-0"
    >
      HARNESS
    </h1>
  </div>
</section>
