---
import HeroObject3D from '../HeroObject3D.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<section
  id="hero"
  aria-labelledby="hero-title"
  class="relative h-screen min-h-screen flex flex-col overflow-hidden bg-bg-primary select-none [--hero-3d-top:4rem] [--hero-3d-width:min(96vw,600px)] [--hero-3d-height:calc(100svh_-_4rem_-_24vw)] sm:[--hero-3d-height:calc(100svh_-_4rem_-_18vw)] lg:[--hero-3d-top:2.5rem] lg:[--hero-3d-width:min(80vw,1100px)] lg:[--hero-3d-height:calc(100svh_-_2.5rem_-_6vw)]"
>
  <!-- Capa z-10: objeto 3D modular en el centro sin brillo de fondo -->
  <HeroObject3D heroSelector="#hero" showGlow={false} />

  <!-- Overlay para el efecto cortina de ServicesProcess -->
  <div
    data-hero-curtain-overlay
    class="absolute inset-0 bg-black pointer-events-none opacity-0 z-20"
    aria-hidden="true"
  ></div>

  <!-- Indicador de scroll minimalista: solo una línea fina que se desliza -->
  <div
    data-hero-scroll
    class="pointer-events-none absolute left-1/2 -translate-x-1/2 z-10 bottom-8 sm:bottom-10 lg:bottom-12 flex flex-col items-center gap-3"
    aria-hidden="true"
  >
    <span class="font-mono text-[10px] uppercase tracking-[0.35em] text-white/50">{t('hero.scroll')}</span>
    <span class="hero-scroll-line relative block h-12 w-px overflow-hidden bg-white/15"></span>
  </div>

  <!-- Heading accesible para SEO y lectores de pantalla (h1 único según SPEC/AGENTS.md) -->
  <h1 id="hero-title" class="sr-only">
    {t('hero.srTitle')}
  </h1>
</section>

<style>
  .hero-scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.85);
    transform: translateY(-100%);
    animation: hero-scroll-slide 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes hero-scroll-slide {
    0% {
      transform: translateY(-100%);
    }
    55% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-line::after {
      animation: none;
      transform: translateY(0);
      opacity: 0.5;
    }
  }
</style>
