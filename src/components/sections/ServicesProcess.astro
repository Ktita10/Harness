---
import { getCollection } from 'astro:content';
import TopoBackground from '../ui/TopoBackground.astro';

// ── 1. Datos de Servicios ──────────────────────────────────────────
const services = await getCollection('services');

const order = ['landing-pages', 'tiendanube', 'tienda-online', 'software-a-medida'];
const sortedServices = services.sort((a, b) => {
  const slugA = (a.data.slug || a.id).replace(/\.md$/, '');
  const slugB = (b.data.slug || b.id).replace(/\.md$/, '');
  const indexA = order.indexOf(slugA);
  const indexB = order.indexOf(slugB);
  return (indexA === -1 ? 99 : indexA) - (indexB === -1 ? indexB : 99);
});

// Configuración visual del abanico (Fanned Cards) + Paleta de colores por carta
const deckConfigs = [
  {
    tag: 'CONVERSIÓN DIRECTA',
    wrapperPos: 'lg:z-[10]',
    fanClass: 'lg:-rotate-[11deg] lg:translate-y-10 lg:translate-x-6',
    cardBg: 'bg-[#121214] text-[#F2EEE6] border-white/15 hover:border-[#FF5A00]',
    numColor: 'text-[#FF5A00]',
    tagBg: 'bg-white/10 text-zinc-300',
    descColor: 'text-zinc-400',
    btnClass: 'bg-[#FF5A00] text-[#0A0A0A] group-hover:bg-[#F2EEE6]',
    patternStroke: '#FFFFFF',
    transitionAccent: 'var(--accent)',
  },
  {
    tag: 'ECOMMERCE NUBE',
    wrapperPos: 'lg:-ml-10 xl:-ml-12 lg:z-[20]',
    fanClass: 'lg:-rotate-[3.5deg] lg:translate-y-1',
    cardBg: 'bg-[#FF5A00] text-[#0A0A0A] border-black/15 hover:border-[#F2EEE6]',
    numColor: 'text-[#0A0A0A]',
    tagBg: 'bg-black/15 text-[#0A0A0A]',
    descColor: 'text-black/80 font-medium',
    btnClass: 'bg-[#0A0A0A] text-[#F2EEE6] group-hover:bg-[#F2EEE6] group-hover:text-[#0A0A0A]',
    patternStroke: '#000000',
    transitionAccent: 'var(--accent-contrast)',
  },
  {
    tag: 'TIENDA INDEPENDIENTE',
    wrapperPos: 'lg:-ml-10 xl:-ml-12 lg:z-[30]',
    fanClass: 'lg:rotate-[3.5deg] lg:translate-y-0',
    cardBg: 'bg-[#F2EEE6] text-[#0A0A0A] border-black/10 hover:border-[#FF5A00]',
    numColor: 'text-[#FF5A00]',
    tagBg: 'bg-black/10 text-zinc-800',
    descColor: 'text-zinc-700 font-medium',
    btnClass: 'bg-[#0A0A0A] text-[#F2EEE6] group-hover:bg-[#FF5A00] group-hover:text-[#0A0A0A]',
    patternStroke: '#000000',
    transitionAccent: 'var(--accent-on-light)',
  },
  {
    tag: 'ARQUITECTURA A MEDIDA',
    wrapperPos: 'lg:-ml-10 xl:-ml-12 lg:z-[25]',
    fanClass: 'lg:rotate-[11deg] lg:translate-y-10 lg:-translate-x-6',
    cardBg: 'bg-[#1B1B1F] text-[#F2EEE6] border-[#FF5A00]/35 hover:border-[#FF5A00]',
    numColor: 'text-[#F2EEE6]',
    tagBg: 'bg-[#FF5A00]/20 text-[#FF5A00]',
    descColor: 'text-zinc-300',
    btnClass: 'bg-[#F2EEE6] text-[#0A0A0A] group-hover:bg-[#FF5A00] group-hover:text-[#0A0A0A]',
    patternStroke: '#FF5A00',
    transitionAccent: 'var(--accent)',
  },
];

// ── 2. Datos de Proceso ────────────────────────────────────────────
const steps = [
  {
    number: '01',
    phase: 'FASE 01',
    title: 'Brief inicial',
    description: 'Conversamos por WhatsApp o videollamada para entender tu negocio, propuesta de valor y requerimientos puntuales.',
  },
  {
    number: '02',
    phase: 'FASE 02',
    title: 'Propuesta clara',
    description: 'Te enviamos un alcance cerrado con plazos exactos, precio fijo y los entregables detallados, sin sorpresas.',
  },
  {
    number: '03',
    phase: 'FASE 03',
    title: 'Diseño enfocado',
    description: 'Creamos una interfaz audaz adaptada a tu público objetivo, optimizada para convertir visitas en consultas.',
  },
  {
    number: '04',
    phase: 'FASE 04',
    title: 'Desarrollo veloz',
    description: 'Construimos el sitio con Astro y código limpio, alcanzando 95+ en Lighthouse y tiempos de carga instantáneos.',
  },
  {
    number: '05',
    phase: 'FASE 05',
    title: 'Lanzamiento & Soporte',
    description: 'Conectamos tu dominio, publicamos en producción y te damos 30 días de garantía con soporte técnico directo.',
  },
];
---

<!-- Contenedor Maestro Unificado: Fondo #0A0A0A fijo sin transiciones de color -->
<div
  data-topo-unified-wrapper
  class="relative w-full max-w-full bg-[#0A0A0A] z-10"
>
  <!-- Pista absoluta que mantiene el TopoBackground vivo y continuo en Servicios + Proceso -->
  <div class="absolute inset-0 w-full h-full pointer-events-none z-0">
    <div class="sticky top-0 left-0 w-full h-screen overflow-hidden">
      <TopoBackground density={4.8} initialTheme={0} />
    </div>
  </div>

  <!-- =====================================================================
       PARTE 1: SERVICIOS (Header Centrado + Abanico de Cartas Animado)
       ===================================================================== -->
  <section
    id="servicios"
    aria-labelledby="services-title"
    class="relative pt-14 sm:pt-20 lg:pt-24 pb-20 sm:pb-28 lg:pb-36 px-4 sm:px-6 md:px-8 lg:px-10 xl:px-14 w-full max-w-full overflow-x-clip select-none !bg-transparent z-10"
  >
    <!-- Header Centrado con animación de izquierda a derecha -->
    <div
      data-services-header
      class="max-w-3xl mx-auto mb-14 sm:mb-20 lg:mb-24 flex flex-col items-center text-center gap-4 relative z-10"
    >
      <span
        data-services-text
        class="text-[11px] sm:text-xs font-mono uppercase tracking-[0.25em] text-[#FF5A00] font-bold will-change-transform"
      >
        // SOLUCIONES DIGITALES
      </span>
      <h2
        id="services-title"
        data-services-text
        class="font-display text-4xl sm:text-6xl lg:text-7xl font-black uppercase text-white tracking-tight leading-[0.95] will-change-transform"
      >
        SERVICIOS <span class="font-serif italic font-normal text-[#FF5A00] tracking-normal">QUE OFRECEMOS</span>
      </h2>
      <p
        data-services-text
        class="text-base sm:text-lg lg:text-xl text-zinc-400 font-normal leading-relaxed max-w-2xl mx-auto will-change-transform"
      >
        Elegí la solución exacta para la etapa de tu negocio. Cuatro formatos técnicos concebidos para traccionar y escalar sin deuda de código.
      </p>
    </div>

    <!-- Contenedor Centrado del Abanico de Cartas (Fanned Deck) -->
    <div
      data-deck-fan
      class="deck-fan relative w-full max-w-7xl mx-auto flex flex-col sm:grid sm:grid-cols-2 lg:flex lg:flex-row items-center justify-center gap-6 sm:gap-6 lg:gap-0 pt-2 pb-12 z-10"
    >
      {
        sortedServices.map((service, index) => {
          const slug = (service.data.slug || service.id).replace(/\.md$/, '');
          const cfg = deckConfigs[index % deckConfigs.length];

          return (
            /* Wrapper de animación GSAP: sube desde el centro abajo y luego se abre en abanico */
            <article
              data-deck-entry
              class:list={[
                'deck-card-wrapper relative w-full max-w-[320px] sm:max-w-none lg:w-[290px] xl:w-[320px] will-change-transform hover:!z-50 focus-within:!z-50',
                cfg.wrapperPos,
              ]}
            >
              <!-- Carta interactiva: conserva su rotación de abanico y su efecto hover intacto -->
              <a
                data-card
                data-card-accent={cfg.transitionAccent}
                href={`/servicios/${slug}`}
                aria-label={`Ver servicio: ${service.data.nombre}`}
                class:list={[
                  'deck-card group relative w-full aspect-[3/4.2] rounded-[2rem] sm:rounded-[2.25rem] p-7 sm:p-8 flex flex-col justify-between border overflow-hidden cursor-pointer',
                  'shadow-[0_30px_70px_-15px_rgba(0,0,0,0.85)] transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]',
                  'lg:origin-bottom hover:!rotate-0 hover:!-translate-y-8 hover:scale-[1.06] focus-visible:!rotate-0 focus-visible:!-translate-y-8 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF5A00]',
                  cfg.cardBg,
                  cfg.fanClass,
                ]}
              >
                <!-- Curvas decorativas internas sutiles dentro de cada carta -->
                <svg
                  class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.08] group-hover:opacity-[0.15] transition-opacity duration-500 z-0"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 400 560"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                >
                  <circle cx="380" cy="40" r="180" fill="none" stroke={cfg.patternStroke} stroke-width="1.5" />
                  <circle cx="380" cy="40" r="260" fill="none" stroke={cfg.patternStroke} stroke-width="1.5" />
                  <path d="M-40,420 C120,340 240,520 440,380" fill="none" stroke={cfg.patternStroke} stroke-width="1.5" />
                  <path d="M-40,490 C140,410 260,580 440,450" fill="none" stroke={cfg.patternStroke} stroke-width="1.5" />
                </svg>

                <!-- Parte Superior de la Carta: Número + Tag -->
                <div class="relative z-10 flex items-center justify-between gap-2">
                  <span class:list={['font-display text-4xl sm:text-5xl font-black tracking-tighter leading-none', cfg.numColor]}>
                    0{index + 1}
                  </span>
                  <span class:list={['px-3 py-1 rounded-full text-[9px] sm:text-[10px] font-mono uppercase tracking-[0.16em] font-bold', cfg.tagBg]}>
                    {cfg.tag}
                  </span>
                </div>

                <!-- Centro de la Carta: Nombre del Servicio + Descripción -->
                <div class="relative z-10 my-auto py-6 flex flex-col gap-3 text-left">
                  <h3 class="font-display text-2xl sm:text-3xl font-black uppercase tracking-tight leading-[0.98] group-hover:translate-x-0.5 transition-transform duration-300">
                    {service.data.nombre}
                  </h3>
                  <p class:list={['text-xs sm:text-sm leading-relaxed line-clamp-4', cfg.descColor]}>
                    {service.data.bajada}
                  </p>
                </div>

                <!-- Pie de la Carta: Call to Action Clickeable -->
                <div class="relative z-10 pt-4 border-t border-current/10 flex items-center justify-between">
                  <span class="font-mono text-[11px] sm:text-xs uppercase tracking-[0.18em] font-bold">
                    EXPLORAR SERVICIO
                  </span>
                  <span
                    class:list={[
                      'w-10 h-10 rounded-full flex items-center justify-center text-sm font-black transition-all duration-300 group-hover:rotate-[-45deg] group-hover:scale-110 shadow-md',
                      cfg.btnClass,
                    ]}
                    aria-hidden="true"
                  >
                    ➔
                  </span>
                </div>
              </a>
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- =====================================================================
       PARTE 2: PROCESO (Colores fijos en Dark Mode, sin transición de tema)
       ===================================================================== -->
  <section
    id="proceso"
    aria-labelledby="process-title"
    class="relative w-full max-w-full overflow-hidden !bg-transparent z-10"
  >
    <!-- Overlay para el efecto cortina de FAQ -->
    <div
      data-process-curtain-overlay
      class="absolute inset-0 bg-black pointer-events-none opacity-0 z-20"
      aria-hidden="true"
    ></div>

    <!-- Desktop (>= 1024px): Pinned Full-Screen Horizontal Flow -->
    <div
      data-process-desktop
      class="hidden lg:flex flex-col h-screen min-h-[640px] max-h-[1000px] justify-between relative overflow-hidden !bg-transparent z-10"
    >
      <div
        data-process-track
        class="flex flex-row items-stretch h-full relative will-change-transform"
      >
        <!-- Slide 0: Intro -->
        <div
          data-process-intro
          class="w-[85vw] xl:w-[75vw] h-full flex-shrink-0 flex flex-col justify-center px-12 xl:px-24 relative z-10"
        >
          <h2
            id="process-title"
            data-process-intro-text
            class="font-display text-6xl xl:text-8xl 2xl:text-9xl font-black uppercase tracking-tight text-white leading-[0.9] mb-8 will-change-transform"
          >
            CÓMO <span class="font-serif italic font-normal text-[#FF5A00] tracking-normal">TRABAJAMOS</span>
          </h2>
          <p
            data-process-intro-text
            class="text-xl xl:text-2xl 2xl:text-3xl font-light text-zinc-400 leading-relaxed max-w-2xl will-change-transform"
          >
            Un proceso transparente de 5 pasos diseñado para entregarte una herramienta comercial funcional sin demoras burocráticas.
          </p>
          <div
            data-process-intro-text
            class="mt-12 flex items-center gap-4 text-xs font-mono uppercase tracking-widest text-zinc-400 will-change-transform"
          >
            <span>SCROLL PARA NAVEGAR</span>
            <span class="text-[#FF5A00] text-lg">→</span>
          </div>
        </div>

        <!-- Slides 1 to 5 (Sin transición de colores) -->
        {
          steps.map((step) => (
            <article
              data-process-slide
              class="w-[75vw] xl:w-[65vw] 2xl:w-[60vw] h-full flex-shrink-0 flex flex-col justify-center px-12 xl:px-20 relative z-10"
            >
              <div
                data-process-number
                class="font-display text-8xl xl:text-[10rem] 2xl:text-[12rem] font-black tracking-tighter select-none leading-none mb-4"
                style="-webkit-text-stroke: 2px #FFFFFF; color: transparent;"
              >
                {step.number}
              </div>
              <span class="inline-block font-mono text-xs xl:text-sm uppercase tracking-widest text-[#FF5A00] font-bold mb-3">
                // {step.phase}
              </span>
              <h3 class="font-display text-3xl xl:text-5xl 2xl:text-6xl font-black uppercase tracking-tight text-white leading-tight mb-5">
                {step.title}
              </h3>
              <p class="text-base xl:text-xl 2xl:text-2xl text-zinc-400 leading-relaxed max-w-xl font-normal">
                {step.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>

    <!-- Mobile (< 1024px): Vertical Flow -->
    <div class="block lg:hidden px-6 sm:px-10 py-12 sm:py-16 relative !bg-transparent z-10">
      <div class="mb-10" data-process-mobile-header>
        <h2
          data-process-mobile-text
          class="font-display text-4xl sm:text-6xl font-black uppercase tracking-tight text-white leading-none mb-4"
        >
          CÓMO <span class="font-serif italic font-normal text-[#FF5A00] tracking-normal">TRABAJAMOS</span>
        </h2>
        <p
          data-process-mobile-text
          class="text-base sm:text-lg text-zinc-400 leading-relaxed max-w-md"
        >
          Un proceso transparente de 5 pasos diseñado para entregarte una herramienta comercial funcional sin demoras burocráticas.
        </p>
      </div>

      <div class="space-y-20 relative z-10">
        {
          steps.map((step) => (
            <article class="relative" data-process-mobile-step>
              <div
                data-process-number
                class="font-display text-7xl sm:text-8xl font-black tracking-tighter select-none leading-none mb-3"
                style="-webkit-text-stroke: 1.5px #FFFFFF; color: transparent;"
              >
                {step.number}
              </div>
              <span class="inline-block font-mono text-xs uppercase tracking-widest text-[#FF5A00] font-bold mb-2">
                // {step.phase}
              </span>
              <h3 class="font-display text-2xl sm:text-4xl font-bold uppercase tracking-tight text-white leading-tight mb-3">
                {step.title}
              </h3>
              <p class="text-sm sm:text-base text-zinc-400 leading-relaxed max-w-md font-normal">
                {step.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initServicesAndProcessAnimations() {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion) return;

    const servicesSection = document.querySelector<HTMLElement>('#servicios');
    if (!servicesSection) return;

    // ── 1. Animación de textos de Servicios (de izquierda a derecha) ─────
    const serviceTexts = servicesSection.querySelectorAll<HTMLElement>('[data-services-text]');
    if (serviceTexts.length) {
      gsap.fromTo(
        serviceTexts,
        {
          x: -80,
          opacity: 0,
          clipPath: 'inset(0 100% 0 0)',
        },
        {
          x: 0,
          opacity: 1,
          clipPath: 'inset(0 0% 0 0)',
          duration: 0.95,
          stagger: 0.14,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '[data-services-header]',
            start: 'top 84%',
            toggleActions: 'play none none none',
          },
        }
      );
    }

    // ── 2. Animación del Mazo de Cartas: suben juntas desde abajo y se abren en abanico ──
    const fanContainer = servicesSection.querySelector<HTMLElement>('[data-deck-fan]');
    const cardEntries = Array.from(servicesSection.querySelectorAll<HTMLElement>('[data-deck-entry]'));
    const innerCards = cardEntries.map((el) => el.querySelector<HTMLElement>('.deck-card')!);

    if (fanContainer && cardEntries.length) {
      const mm = gsap.matchMedia();

      // Desktop (>= 1024px): Salen apiladas en el centro desde abajo y se despliegan en abanico
      mm.add('(min-width: 1024px)', () => {
        // Ángulos y alturas finales de cada carta en el abanico
        const targetRotations = [-11, -3.5, 3.5, 11];
        const targetY = [40, 4, 0, 40];
        const targetX = [24, 0, 0, -24];

        // Calculamos cuánto debe moverse cada carta en X para nacer todas juntas en el centro exacto
        const getStackOffsetX = (index: number) => {
          const containerRect = fanContainer.getBoundingClientRect();
          const containerCenter = containerRect.left + containerRect.width / 2;
          const cardRect = cardEntries[index].getBoundingClientRect();
          const cardCenter = cardRect.left + cardRect.width / 2;
          return containerCenter - cardCenter;
        };

        // Desactivamos temporalmente la transition de CSS durante la entrada para que GSAP tenga control total
        innerCards.forEach((c) => (c.style.transition = 'none'));

        const deckTl = gsap.timeline({
          scrollTrigger: {
            trigger: fanContainer,
            start: 'top 82%',
            toggleActions: 'play none none none',
          },
          onComplete: () => {
            // Restauramos la transición CSS e inline styles para que el hover del abanico funcione perfecto
            innerCards.forEach((c) => {
              c.style.transition = '';
              gsap.set(c, { clearProps: 'transform' });
            });
            cardEntries.forEach((w) => gsap.set(w, { clearProps: 'transform,opacity' }));
          },
        });

        // Estado inicial: las 4 cartas juntas en el centro (como un solo mazo vertical) y abajo
        deckTl.set(cardEntries, {
          x: (i) => getStackOffsetX(i),
          y: 260,
          opacity: 0,
          scale: 0.88,
        });

        deckTl.set(innerCards, {
           rotate: 0,
          y: 0,
          x: 0,
        });

        // FASE 1: Salen todas juntas desde abajo hacia el centro
        deckTl.to(cardEntries, {
          y: 0,
          opacity: 1,
          scale: 1,
          duration: 0.75,
          ease: 'power3.out',
          stagger: 0.03, // micro-desfase para dar sensación de grosor de mazo
        });

        // FASE 2: Se despliegan hacia los lados tomando sus posiciones y ángulos de abanico
        deckTl.to(
          cardEntries,
          {
            x: 0,
            duration: 0.85,
            ease: 'back.out(1.4)',
          },
          '-=0.15'
        );

        deckTl.to(
          innerCards,
          {
            rotate: (i) => targetRotations[i],
            y: (i) => targetY[i],
            x: (i) => targetX[i],
            duration: 0.85,
            ease: 'back.out(1.4)',
          },
          '<'
        );
      });

      // Mobile / Tablet (< 1024px): Suben desde abajo con ligero despliegue
      mm.add('(max-width: 1023px)', () => {
        gsap.fromTo(
          cardEntries,
          { y: 120, opacity: 0, scale: 0.92 },
          {
            y: 0,
            opacity: 1,
            scale: 1,
            duration: 0.8,
            stagger: 0.12,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: fanContainer,
              start: 'top 85%',
              toggleActions: 'play none none none',
            },
          }
        );
      });
    }

    // ── 3. Animación de textos en Proceso (de izquierda a derecha) ──────
    const processIntroTexts = document.querySelectorAll<HTMLElement>('[data-process-intro-text]');
    if (processIntroTexts.length) {
      gsap.fromTo(
        processIntroTexts,
        {
          x: -80,
          opacity: 0,
          clipPath: 'inset(0 100% 0 0)',
        },
        {
          x: 0,
          opacity: 1,
          clipPath: 'inset(0 0% 0 0)',
          duration: 0.95,
          stagger: 0.15,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#proceso',
            start: 'top 75%',
            toggleActions: 'play none none none',
          },
        }
      );
    }

    const processMobileTexts = document.querySelectorAll<HTMLElement>('[data-process-mobile-text]');
    if (processMobileTexts.length) {
      gsap.fromTo(
        processMobileTexts,
        { x: -60, opacity: 0 },
        {
          x: 0,
          opacity: 1,
          duration: 0.85,
          stagger: 0.14,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '[data-process-mobile-header]',
            start: 'top 85%',
          },
        }
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initServicesAndProcessAnimations);
  } else {
    initServicesAndProcessAnimations();
  }
  document.addEventListener('astro:page-load', initServicesAndProcessAnimations);
</script>

<script>
  import { initCardTransitions } from '../../scripts/card-transition';

  initCardTransitions();
</script>

<style is:global>
  /* Garantiza que #proceso nunca cambie de color ni tape las curvas topográficas */
  #proceso,
  .pin-spacer:has(> #proceso) {
    background-color: transparent !important;
  }

  /* Efecto de abanico interactivo en desktop: cuando pasás el mouse por una carta,
     las demás se atenúan muy sutilmente para que la activa resalte todavía más */
  @media (min-width: 1024px) {
    .deck-fan:has(.deck-card:hover) .deck-card:not(:hover) {
      filter: brightness(0.82);
    }
  }
</style>