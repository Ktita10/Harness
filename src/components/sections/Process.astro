---
const steps = [
  {
    number: '01',
    phase: 'FASE 01',
    title: 'Brief inicial',
    description: 'Conversamos por WhatsApp o videollamada para entender tu negocio, propuesta de valor y requerimientos puntuales.',
  },
  {
    number: '02',
    phase: 'FASE 02',
    title: 'Propuesta clara',
    description: 'Te enviamos un alcance cerrado con plazos exactos, precio fijo y los entregables detallados, sin sorpresas.',
  },
  {
    number: '03',
    phase: 'FASE 03',
    title: 'Diseño enfocado',
    description: 'Creamos una interfaz audaz adaptada a tu público objetivo, optimizada para convertir visitas en consultas.',
  },
  {
    number: '04',
    phase: 'FASE 04',
    title: 'Desarrollo veloz',
    description: 'Construimos el sitio con Astro y código limpio, alcanzando 95+ en Lighthouse y tiempos de carga instantáneos.',
  },
  {
    number: '05',
    phase: 'FASE 05',
    title: 'Lanzamiento & Soporte',
    description: 'Conectamos tu dominio, publicamos en producción y te damos 30 días de garantía con soporte técnico directo.',
  },
];
---

<section
  id="proceso"
  aria-labelledby="process-title"
  class="relative w-full max-w-full overflow-hidden transition-colors duration-200"
  style="--process-bg: #0A0A0A; --process-text: #FFFFFF; --process-muted: #A1A1AA; background-color: var(--process-bg);"
>
  <!-- Desktop (>= 1024px): Pinned Full-Screen Horizontal Flow -->
  <div
    data-process-desktop
    class="hidden lg:flex flex-col h-screen min-h-[640px] max-h-[1000px] justify-between relative overflow-hidden"
  >
    <div
      data-process-track
      class="flex flex-row items-stretch h-full relative will-change-transform"
    >
      <!-- Slide 0: Intro (Massive Heading & Description) -->
      <div
        data-process-intro
        class="w-[85vw] xl:w-[75vw] h-full flex-shrink-0 flex flex-col justify-center px-12 xl:px-24 relative z-10"
      >
        <div class="flex items-center gap-3 mb-6 font-mono text-xs xl:text-sm uppercase tracking-widest text-accent font-bold">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-accent animate-pulse"></span>
          <span>03 / METODOLOGÍA</span>
        </div>
        <h2
          id="process-title"
          class="font-display text-6xl xl:text-8xl 2xl:text-9xl font-black uppercase tracking-tight text-[var(--process-text)] leading-[0.9] mb-8"
        >
          Cómo trabajamos
        </h2>
        <p class="text-xl xl:text-2xl 2xl:text-3xl font-light text-[var(--process-muted)] leading-relaxed max-w-2xl">
          Un proceso transparente de 5 pasos diseñado para entregarte una herramienta comercial funcional sin demoras burocráticas.
        </p>
        <div class="mt-12 flex items-center gap-4 text-xs font-mono uppercase tracking-widest text-[var(--process-muted)]">
          <span>SCROLL PARA NAVEGAR</span>
          <span class="text-accent text-lg">→</span>
        </div>
      </div>

      <!-- Slides 1 to 5: Large, fluid, zero border separators -->
      {
        steps.map((step) => (
          <article
            data-process-slide
            class="w-[75vw] xl:w-[65vw] 2xl:w-[60vw] h-full flex-shrink-0 flex flex-col justify-center px-12 xl:px-20 relative z-10"
          >
            <div
              data-process-number
              class="font-display text-8xl xl:text-[10rem] 2xl:text-[12rem] font-black tracking-tighter select-none leading-none mb-4 text-[var(--process-text)] transition-colors duration-300"
              style="-webkit-text-stroke: 2px currentColor; color: transparent;"
            >
              {step.number}
            </div>
            <span class="inline-block font-mono text-xs xl:text-sm uppercase tracking-widest text-accent font-bold mb-3">
              // {step.phase}
            </span>
            <h3 class="font-display text-3xl xl:text-5xl 2xl:text-6xl font-black uppercase tracking-tight text-[var(--process-text)] leading-tight mb-5 transition-colors duration-300">
              {step.title}
            </h3>
            <p class="text-base xl:text-xl 2xl:text-2xl text-[var(--process-muted)] leading-relaxed max-w-xl font-normal transition-colors duration-300">
              {step.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>

  <!-- Mobile (< 1024px): Vertical Flow with Large Typography -->
  <div class="block lg:hidden px-6 sm:px-10 py-20 relative">
    <div class="mb-16">
      <div class="flex items-center gap-3 mb-3 font-mono text-xs uppercase tracking-widest text-accent font-bold">
        <span class="inline-block w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        <span>03 / METODOLOGÍA</span>
      </div>
      <h2
        class="font-display text-4xl sm:text-6xl font-black uppercase tracking-tight text-[var(--process-text)] leading-none mb-4"
      >
        Cómo trabajamos
      </h2>
      <p class="text-base sm:text-lg text-[var(--process-muted)] leading-relaxed max-w-md">
        Un proceso transparente de 5 pasos diseñado para entregarte una herramienta comercial funcional sin demoras burocráticas.
      </p>
    </div>

    <div class="space-y-20 relative z-10">
      {
        steps.map((step) => (
          <article class="relative">
            <div
              data-process-number
              class="font-display text-7xl sm:text-8xl font-black tracking-tighter select-none leading-none mb-3 text-[var(--process-text)]"
              style="-webkit-text-stroke: 1.5px currentColor; color: transparent;"
            >
              {step.number}
            </div>
            <span class="inline-block font-mono text-xs uppercase tracking-widest text-accent font-bold mb-2">
              // {step.phase}
            </span>
            <h3 class="font-display text-2xl sm:text-4xl font-bold uppercase tracking-tight text-[var(--process-text)] leading-tight mb-3">
              {step.title}
            </h3>
            <p class="text-sm sm:text-base text-[var(--process-muted)] leading-relaxed max-w-md font-normal">
              {step.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
