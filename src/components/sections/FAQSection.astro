---
import { getCollection } from 'astro:content';
import FAQCubes3D from '../FAQCubes3D.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface FAQItem {
  pregunta: string;
  respuesta: string;
}

interface Props {
  lang?: Lang;
  items?: FAQItem[];
  title?: string;
  titleAccent?: string;
  subtitle?: string;
  isServicePage?: boolean;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const {
  items,
  title = t('faq.title'),
  titleAccent = t('faq.titleAccent'),
  subtitle = t('faq.subtitle'),
  isServicePage = false,
} = Astro.props;

let faqList: FAQItem[] = [];
if (items && items.length > 0) {
  faqList = items;
} else {
  const allFaqs = currentLang === 'en' ? await getCollection('faqs_en') : await getCollection('faqs');
  const sortedFaqs = allFaqs.sort((a, b) => (a.data.orden ?? 0) - (b.data.orden ?? 0));
  faqList = sortedFaqs.map((f) => ({
    pregunta: f.data.pregunta,
    respuesta: f.data.respuesta,
  }));
}
---

<!-- Cortina Crema (#F2EEE6) con esquinas cuadradas y 5 cubos 3D en los flancos -->
<section
  id="faq"
  data-faq-panel
  data-nav-light
  aria-labelledby="faq-title"
  class:list={[
    'faq-curtain-surface relative z-20 w-full text-[#0D0D0D] rounded-none shadow-[0_-30px_60px_-15px_rgba(0,0,0,0.35)] border-t border-black/10 pt-16 sm:pt-24 pb-16 sm:pb-20 lg:pb-24 px-6 sm:px-12 lg:px-20 overflow-hidden',
    !isServicePage && 'lg:-mt-[100vh]',
  ]}
>
  <!-- 5 Cubos 3D de distintos tamaños dispersos en los flancos laterales -->
  <FAQCubes3D sectionSelector="#faq" />

  <div class="relative z-10 max-w-3xl mx-auto flex flex-col items-center">
    <!-- Encabezado centrado con Tipografía gruesa arriba y fina abajo emparejadas -->
    <div data-faq-header class="w-full flex flex-col items-center text-center mb-10 sm:mb-14">
      <h2
        id="faq-title"
        data-heading-pair
        class="inline-flex flex-col items-start text-left text-4xl sm:text-5xl lg:text-6xl font-black uppercase text-[#0D0D0D] leading-[0.88] tracking-tight mb-5 sm:mb-6"
      >
        <span data-heading-top class="font-display font-black uppercase block whitespace-nowrap leading-[0.88]">
          {title}
        </span>
        <span data-heading-bottom class="font-serif italic font-normal text-[#FF5A00] tracking-normal block whitespace-nowrap leading-[0.88] pr-[0.04em] mt-1">
          {titleAccent}
        </span>
      </h2>
      <p class="text-base sm:text-lg text-neutral-700 leading-relaxed max-w-xl font-medium">
        {subtitle}
      </p>
    </div>

    <!-- Acordeón centrado en una sola columna -->
    <div data-faq-list class="w-full border-t border-black/12">
      {
        faqList.map((faq, index) => (
          <details
            data-faq-item
            name="faq"
            open={index === 0}
            class="group border-b border-black/12"
          >
            <summary class="flex justify-between items-center gap-6 py-5 sm:py-7 cursor-pointer list-none select-none font-display font-bold text-lg sm:text-xl text-[#0D0D0D] hover:text-[#FF5A00] transition-colors">
              <span>{faq.pregunta}</span>
              <span
                aria-hidden="true"
                class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-black/20 bg-[#F2EEE6] text-[#0D0D0D] font-bold text-xl shrink-0 shadow-sm group-hover:border-[#FF5A00] group-hover:text-[#FF5A00] group-open:rotate-45 group-open:bg-[#FF5A00] group-open:text-[#0D0D0D] group-open:border-[#FF5A00] transition-all duration-200"
              >
                +
              </span>
            </summary>
            <div class="pb-7 pr-12 text-neutral-700 text-base sm:text-lg leading-relaxed font-medium">
              <p>{faq.respuesta}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-curtain-surface {
    background-color: #F2EEE6;
    background-image: linear-gradient(
      180deg,
      #F2EEE6 0%,
      #F2EEE6 66%,
      #F4E9DD 78%,
      #F7DFC9 90%,
      #FAD3B2 100%
    );
  }
</style>
